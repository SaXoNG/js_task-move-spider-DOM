document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    if (e.target.closest(".wall")) {
        var spiderRect = spider.getBoundingClientRect();
        var wallRect = wall.getBoundingClientRect();
        var wallOffset = 9.6;
        var newX = e.clientX - wallRect.left - spiderRect.width / 2 - wallOffset;
        var newY = e.clientY - wallRect.top - spiderRect.height / 2 - wallOffset;
        newX = Math.max(0, Math.min(newX, wall.clientWidth - spiderRect.width));
        newY = Math.max(0, Math.min(newY, wall.clientHeight - spiderRect.height));
        spider.style.transform = "translate(".concat(newX, "px, ").concat(newY, "px)");
    }
});

